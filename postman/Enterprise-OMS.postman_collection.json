          "name": "Register User - Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Registration succeeds\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response contains user ID\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.id).to.exist;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Role is ADMIN\", function () {\r",
                  "    const json = pm.response.json();\r",
                  "    pm.expect(json.role).to.eql(\"ADMIN\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"address\": \"Chennai\",\r\n  \"name\": \"OMS Admin\",\r\n  \"email\": \"omsadmin@gmail.com\",\r\n  \"password\": \"Admin@123\",\r\n  \"phone\": \"9876543210\",\r\n  \"role\": \"ADMIN\"\r\n}",
